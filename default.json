{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "schedule:weekly"
  ],
  "timezone": "Europe/Berlin",
  "minimumReleaseAge": "3 days",
  "commitMessagePrefix": "chore:",
  "dependencyDashboard": false,
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    { 
      "matchUpdateTypes": [
        "minor",
        "patch", 
        "digest"
      ],
      "automerge": true
    }
  ]
}
